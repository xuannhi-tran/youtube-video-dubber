# Copy this file to .env (same folder) and fill in what you use. .env is git-ignored.

# --- keys: only the providers you use ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- which LLM, for everything (default: groq when GROQ_API_KEY is set) ---
# LLM_PROVIDER=groq      # groq | gemini | ollama | lmstudio
# LLM_MODEL=             # empty = the provider's default

# --- different LLMs for translation and for shortening (override the two above) ---
# TRANSLATE_LLM_PROVIDER=gemini
# TRANSLATE_LLM_MODEL=gemini-3.5-flash-lite    # python llm.py --list gemini shows the exact names
# FIT_LLM_PROVIDER=groq
# FIT_LLM_MODEL=openai/gpt-oss-120b
# REVIEW_LLM_PROVIDER=gemini   # optional second pass: fixes wrong or noticeably awkward Vietnamese lines
# REVIEW_LLM_MODEL=gemma-4-31b-it
# REVIEW_WORKERS=4             # chunks checked at the same time
# REVIEW_TIMEOUT=150           # seconds a chunk waits for its check before keeping the draft (0 = no limit);
#                              # after 3 failures in a row (or a quota stop) the check is off for that run
# TRANSLATE_LLM_REASONING=     # low | none ...: how hard a Groq/Gemini model thinks (also FIT_ / REVIEW_); empty = default
# FIT_FALLBACK_PROVIDER=ollama   # shortening only: takes over when the main LLM hits its daily limit
# FIT_FALLBACK_MODEL=qwen3:8b

# --- Gemini ---
# GEMINI_RPM=10          # requests per minute to stay under (free Flash Lite: 15)

# --- local models (Ollama / LM Studio) ---
# LOCAL_LLM_URL=http://localhost:11434/v1    # LM Studio: http://localhost:1234/v1
# LOCAL_LLM_TIMEOUT=600
# LOCAL_LLM_THINK=0      # 1 lets Qwen3 think before answering (slower)

# --- voice (VieNeu preset; python compare_voices.py lets you listen to all of them) ---
# TTS_VOICE=thien_minh   # default: xuan_vinh
# TTS_DEVICE=cuda       # read on the GPU (needs PyTorch with CUDA, see the README); default: cpu
# TTS_BATCH=8          # GPU only: blocks read in one pass (default 1; saves little, see the README)

# --- Vietnamese subtitles (python dub.py URL --subs); command-line options win ---
# SUB_FONT=Arial         # an installed font that has Vietnamese diacritics
# SUB_FONT_SIZE=0        # pixels of the video, 0 = automatic
# SUB_BAR=0              # black bar height in pixels, 0 = automatic (about 17% of the video height)

# --- disk space: what to delete after a video is made (see the README) ---
# CLEANUP=clips          # none (default) | clips (voice clips + audio) | all (also source video + dub track)
# EXPORT_DIR=C:\Users\you\Google Drive\Dubbed   # copy every finished video here as <video id>.mp4 (e.g. a synced cloud folder; must exist)

# --- other ---
# LLM_MAX_TOKENS=900     # cap on the answer length (some models allow very little per minute)
